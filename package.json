{
	"name": "fairy",
	"author": "Keit",
	"private": true,
	"version": "0.0.1",
	"description": "Discord bot for server VoidHunters",
	"main": "dist/index.js",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"start": "tsx src/index.ts",
		"deploy": "tsx src/deploy-commands.ts",
		"build": "tsc",
		"test": "echo \"Error: no test specified\" && exit 1",
		"check": "biome check --write .",
		"format": "biome format --write .",
		"lint": "biome lint ."
	},
	"license": "MIT",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.21.0",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@12.21.0",
	"type": "module",
	"dependencies": {
		"discord.js": "^14.28.1",
		"dotenv": "^18.0.10",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^26.6.6",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	}
}
