{
	"name": "fairy",
	"private": true,
	"author": "Keit",
	"description": "Discord bot for server VoidHunters",
	"version": "0.0.1",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Keit32/fairy.git"
	},
	"bugs": {
		"url": "https://github.com/Keit32/fairy/issues"
	},
	"homepage": "https://github.com/Keit32/fairy#readme",
	"main": "dist/index.js",
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/index.ts | pnpm exec pino-pretty",
		"start": "tsx src/index.ts",
		"deploy": "tsx src/shared/utils/deploy-commands.ts",
		"build": "tsc",
		"typecheck": "tsc --noEmit",
		"knip": "knip",
		"prepare": "lefthook install",
		"test": "echo \"Error: no test specified\" && exit 1",
		"check": "biome check --write .",
		"format": "biome format --write .",
		"lint": "biome lint ."
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": ">=12.0.0 <13.0.0",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@12.21.0",
	"dependencies": {
		"discord.js": "^14.28.1",
		"dotenv": "^18.0.10",
		"pino": "^10.4.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^26.6.6",
		"knip": "^6.47.0",
		"lefthook": "^2.2.2",
		"pino-pretty": "^13.2.0",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	}
}
